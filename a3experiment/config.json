{
    "$schema": "https://raw.githubusercontent.com/revisit-studies/study/main/src/parser/StudyConfigSchema.json",
    "studyMetadata": {
        "title": "Map Visualization Population Estimation Study",
        "version": "pilot",
        "authors": [
            "Sarah Meyer",
            "Cole Golding"
        ],
        "date": "2025-02-10",
        "description": "This study aims to test users' ability to gauge population size on a map using four different map visualizations (Choropleth, spike, hexbin, and bubble).",
        "organizations": [
            "WPI"
        ]
    },
    "uiConfig": {
        "contactEmail": "sjmeyer@wpi.edu",
        "helpTextPath": "a3experiment/assets/help.md",
        "logoPath": "revisitAssets/revisitLogoSquare.svg",
        "withProgressBar": true,
        "autoDownloadStudy": false,
        "withSidebar": true
    },
    "baseComponents": {
      "map-base": {
        "type": "website",
        "path": "a3experiment/map.html",
        "instructionLocation": "aboveStimulus"
      }
    },
    "components": {
        "introduction": {
            "type": "markdown",
            "path": "a3experiment/assets/introduction.md",
            "response": []
        },
        "trial-choropleth": {
            "baseComponent": "map-base",
            "parameters": {
                "mapType": "choropleth"
            },
            "instruction": "Identify which region has a larger population.",
            "response": [
                {
                    "id": "choropleth-response",
                    "prompt": "How many times more populated is City A than City B?",
                    "type": "numerical",
                    "required": true
                }
            ]
        },
        "trial-spike": {
            "baseComponent": "map-base",
            "parameters": {
                "mapType": "spike"
            },
            "instruction": "Identify which region has a larger population.",
            "response": [{ "id": "spike-response", "prompt": "How many times more populated is City A than City B?", "type": "numerical", "required": true }]
        },
        "trial-hexbin": {
            "baseComponent": "map-base",
            "parameters": {
                "mapType": "hexbin"
            },
            "instruction": "Identify which region has a larger population.",
            "response": [{ "id": "hexbin-response", "prompt": "How many times more populated is City A than City B?", "type": "numerical", "required": true }]
        },
        "trial-bubble": {
            "baseComponent": "map-base",
            "parameters": {
                "mapType": "bubble"
            },
            "instruction": "Identify which region has a larger population.",
            "response": [{ "id": "bubble-response", "prompt": "How many times more populated is City A than City B?", "type": "numerical", "required": true }]
        }
    },
    "sequence": {
        "order": "fixed",
        "components": [
            "introduction",
            {
                "order": "random",
                "components": [
                    "trial-choropleth",
                    "trial-choropleth",
                    "trial-choropleth",
                    "trial-choropleth",
                    "trial-choropleth",
                    "trial-spike",
                    "trial-spike",
                    "trial-spike",
                    "trial-spike",
                    "trial-spike",
                    "trial-hexbin",
                    "trial-hexbin",
                    "trial-hexbin",
                    "trial-hexbin",
                    "trial-hexbin",
                    "trial-bubble",
                    "trial-bubble",
                    "trial-bubble",
                    "trial-bubble",
                    "trial-bubble"
                ]
            }
        ]
    }
}